# =============================================================================
# 20260818 Claude Provenance Robustness Experiment - Git Ignore Rules
# =============================================================================

# Python Bytecode and Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables, Secrets and Credentials (去識別化與資安防護)
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.crt
credentials.json
token.json
*secret*
*password*

# Operating System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor Directories
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Testing & Coverage Artifacts
.coverage
.coverage.*
.pytest_cache/
htmlcov/
nosetests.xml
coverage.xml

# Temporary and Scratch Directories
tmp/
temp/
scratch/
